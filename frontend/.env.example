# Contact form delivery (Resend). With no RESEND_API_KEY outside production the
# route handler runs in dry-run mode and logs submissions instead of sending.
RESEND_API_KEY=
CONTACT_TO_EMAIL=s.n.psaradellis@gmail.com
# Must be an address on a domain verified in Resend, e.g. "ShortForge <hello@shortforge.dev>".
# Falls back to onboarding@resend.dev, which only delivers to the Resend account owner.
CONTACT_FROM_EMAIL=
# Set to 1 to force dry-run mode even when a key is present.
CONTACT_DRY_RUN=
